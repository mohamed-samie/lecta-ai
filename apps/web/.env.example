# ─────────────────────────────────────
# Lecta AI — Environment Configuration
# ─────────────────────────────────────
# Copy this file as `.env.local` and fill in your values:
#   cp .env.example .env.local

# Base URL for the backend API (required for production)
# Example: https://api.lecta-ai.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Node environment (development | production)
NODE_ENV=development
